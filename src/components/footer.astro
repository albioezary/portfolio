---
import "../styles/footer.css";
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-copy">
        <p class="footer-eyebrow">Have a project in mind?</p>

        <h2 class="footer-heading">
          Let's talk.<br />
          Make it matter.
        </h2>
      </div>

      <div class="footer-contact">
        <div class="contact-block">
          <span class="contact-label">EMAIL</span>

          <a href="mailto:aoezary@gmail.com">
            <span>aoezary@gmail.com</span>
            <span>↗</span>
          </a>
        </div>

        <div class="contact-block">
          <span class="contact-label">WHATSAPP</span>

          <a
            href="https://wa.me/6281807881170"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>+62 818 0788 1170</span>
            <span>↗</span>
          </a>
        </div>

        <div class="social-block">
          <span class="contact-label">FOLLOW</span>

          <div class="social-links">
            <!-- LinkedIn -->
            <a
              href="https://www.linkedin.com/in/albi-oezary-356b43316/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
            >
              <i class="ri-linkedin-fill"></i>
            </a>

            <!-- Instagram -->
            <a
              href="https://instagram.com/albioezary"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <i class="ri-instagram-line"></i>
            </a>

            <!-- Email -->
            <a href="mailto:aoezary@gmail.com" aria-label="Email">
              <i class="ri-mail-line"></i>
            </a>

            <!-- Behance -->
            <a
              href="https://behance.net/albioezary"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Behance"
            >
              <i class="ri-behance-fill"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
